/*
 ====================================================
 Section Section 6 — Cost Structure
 ====================================================
 
 Objective
 Understand how total financial losses are distributed across different cost categories.
 
 Business Questions
 1. What percentage of total losses comes from direct operational losses?
 2. What percentage comes from recovery costs?
 3. What percentage comes from legal expenses?
 4. What percentage comes from regulatory fines?
 5. What percentage comes from ransom paid?
 6. Which sectors receive the largest insurance payouts?
 7. How does insurance coverage differ across industries?
 
 */
-- 1,2,3,4,5
SELECT ROUND(
        SUM(direct_loss_usd) / SUM(total_loss_usd) * 100,
        2
    ) AS direct_pct,
    ROUND(
        SUM(recovery_cost_usd) / SUM(total_loss_usd) * 100,
        2
    ) AS recovery_pct,
    ROUND(
        SUM(legal_fees_usd) / SUM(total_loss_usd) * 100,
        2
    ) AS legal_pct,
    ROUND(
        SUM(regulatory_fine_usd) / SUM(total_loss_usd) * 100,
        2
    ) AS regulatory_pct,
    ROUND(
        SUM(ransom_paid_usd) / SUM(total_loss_usd) * 100,
        2
    ) AS ransom_pct
FROM financial_impact
WHERE total_loss_usd IS NOT NULL;
-- 6
SELECT mr.sector_index,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_loss,
    COUNT(*) AS attacks,
    ROUND(AVG(fi.insurance_payout_usd), 2) AS avg_insurance_payout
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
WHERE fi.insurance_payout_usd IS NOT NULL
GROUP BY mr.sector_index
ORDER BY avg_loss DESC;
-- 7
SELECT mr.sector_index,
    COUNT(*) AS attacks,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_loss,
    ROUND(AVG(fi.insurance_payout_usd), 2) AS avg_insurance_payout,
    ROUND(
        AVG(
            (fi.insurance_payout_usd / fi.total_loss_usd) * 100
        ),
        2
    ) AS avg_insurance_coverage_pct
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
WHERE fi.total_loss_usd IS NOT NULL
    AND fi.total_loss_usd > 0
    AND fi.insurance_payout_usd IS NOT NULL
GROUP BY mr.sector_index
ORDER BY avg_insurance_coverage_pct DESC;