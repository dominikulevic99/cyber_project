/*
 ====================================================
 Section 1 — Industry Financial Risk
 ====================================================
 
 Objective:
 Identify which sectors are most financially exposed to cyberattacks by comparing
 attack frequency, average financial loss, total financial loss, recovery time,
 and extreme outlier incidents.
 
 Business Questions:
 1. Which sectors suffer the highest average financial loss per cyberattack?
 2. Which sectors experience cyberattacks most frequently?
 3. Which sectors have the highest total financial losses?
 4. Which sectors have both above-average losses and above-average recovery times?
 5. Which incidents were the strongest outliers compared with their sector average?
 6. Which companies experienced losses more than 200% above their sector average?
 */
-- 1,2,3
SELECT mr.sector_index,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_loss,
    COUNT(*) AS attacks,
    ROUND(SUM(fi.total_loss_usd), 2) AS total_loss
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
GROUP BY mr.sector_index
ORDER BY avg_loss DESC;
-- 4
SELECT mr.sector_index,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_sector_loss,
    ROUND(AVG(mr.days_to_price_recovery), 2) AS avg_sector_recovery_time,
    COUNT(*) AS incidents
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
WHERE fi.total_loss_usd IS NOT NULL
    AND mr.days_to_price_recovery IS NOT NULL
GROUP BY mr.sector_index
HAVING AVG(fi.total_loss_usd) > (
        SELECT AVG(total_loss_usd)
        FROM financial_impact
        WHERE total_loss_usd IS NOT NULL
    )
    AND AVG(mr.days_to_price_recovery) > (
        SELECT AVG(days_to_price_recovery)
        FROM market_reaction
        WHERE days_to_price_recovery IS NOT NULL
    )
ORDER BY avg_sector_loss DESC;
-- 5 
-- This is highlight of 10 companies wchich loss above sector average was the most higher. 
-- With in information about sector and loss abve sector average. 
WITH sector_avg_loss AS (
    SELECT mr.sector_index,
        ROUND(AVG(fi.total_loss_usd), 2) AS avg_sector_loss
    FROM financial_impact fi
        JOIN market_reaction mr ON fi.incident_id = mr.incident_id
    WHERE fi.total_loss_usd IS NOT NULL
    GROUP BY mr.sector_index
)
SELECT md.company_name,
    mr.sector_index,
    fi.incident_id,
    fi.total_loss_usd,
    sector_avg_loss.avg_sector_loss,
    ROUND(
        fi.total_loss_usd - sector_avg_loss.avg_sector_loss,
        2
    ) AS loss_above_sector_avg
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
    JOIN incident_metadata md ON fi.incident_id = md.incident_id
    JOIN sector_avg_loss ON mr.sector_index = sector_avg_loss.sector_index
WHERE fi.total_loss_usd IS NOT NULL
ORDER BY loss_above_sector_avg DESC
LIMIT 10;
-- 6
WITH sector_average_loss AS(
    SELECT sector_index,
        ROUND(AVG(total_loss_usd), 2) AS avg_sector_loss
    FROM financial_impact fi
        JOIN market_reaction mr ON fi.incident_id = mr.incident_id
    WHERE total_loss_usd IS NOT NULL
    GROUP BY sector_index
)
SELECT im.company_name,
    fi.total_loss_usd,
    mr.sector_index,
    sal.avg_sector_loss
FROM financial_impact fi
    JOIN incident_metadata im ON fi.incident_id = im.incident_id
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
    JOIN sector_average_loss sal ON mr.sector_index = sal.sector_index
WHERE total_loss_usd > (sal.avg_sector_loss * 3)
ORDER BY total_loss_usd DESC;