/*
 ====================================================
 Section 4 —  Market Reaction
 ====================================================
 
 Objective
 
 Measure investor reaction following cyberattack disclosure and evaluate market recovery across industries.
 Business Questions
 
 1. How much does the stock price fall after disclosure?
 2. What percentage of the stock price recovers within 30 days?
 3. How many days does full recovery take across industries?
 4. Which sectors recover slower than the overall average?
 5. Which sectors have above-average recovery times?
 
 */
-- 1,2,3
SELECT mr.sector_index,
    COUNT(*) AS incidents,
    ROUND(
        AVG(
            (
                (price_disclosure_day - price_7d_before) / price_7d_before
            ) * 100
        ),
        2
    ) AS avg_disclosure_change_pct,
    ROUND(
        AVG(
            (
                (price_30d_after - price_disclosure_day) / price_disclosure_day
            ) * 100
        ),
        2
    ) AS avg_recovery_pct,
    ROUND(AVG(days_to_price_recovery), 2) AS avg_days_to_recovery
FROM market_reaction mr
GROUP BY mr.sector_index
ORDER BY avg_disclosure_change_pct;
--4
SELECT mr.sector_index,
    ROUND(AVG(mr.days_to_price_recovery), 2) AS avg_recovery_days,
    COUNT(*) AS incidents
FROM market_reaction mr
WHERE mr.days_to_price_recovery IS NOT NULL
GROUP BY mr.sector_index
HAVING AVG(mr.days_to_price_recovery) > (
        SELECT AVG(days_to_price_recovery)
        FROM market_reaction
        WHERE days_to_price_recovery IS NOT NULL
    )
ORDER BY avg_recovery_days DESC;
-- 5
WITH sector_recovery AS (
    SELECT sector_index,
        ROUND(AVG(days_to_price_recovery), 2) AS avg_sector_recovery
    FROM market_reaction
    WHERE days_to_price_recovery IS NOT NULL
    GROUP BY sector_index
),
overall_recovery AS (
    SELECT ROUND(AVG(days_to_price_recovery), 2) AS overall_avg_recovery
    FROM market_reaction
    WHERE days_to_price_recovery IS NOT NULL
)
SELECT sr.sector_index,
    sr.avg_sector_recovery,
    oar.overall_avg_recovery,
    ROUND(
        sr.avg_sector_recovery - oar.overall_avg_recovery,
        2
    ) AS difference
FROM sector_recovery sr
    CROSS JOIN overall_recovery oar
WHERE sr.avg_sector_recovery > oar.overall_avg_recovery
ORDER BY sr.avg_sector_recovery DESC;