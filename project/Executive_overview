
"""
We are focusing on cyber attacks impact on companies fiancials which includes total loss and average loss for each company as well as average recovery with respect of incidents amount.

-- need to write a intro to the all analysis wchich contais individuals files and answer each sector business question.
"""


SELECT
    COUNT(*) AS total_incidents,
    SUM(total_loss_usd) AS total_financial_loss,
    ROUND(AVG(total_loss_usd), 2) AS average_loss,
    ROUND(AVG(days_to_price_recovery), 0) AS avg_recovery_days,
    ROUND(AVG(ransom_paid_usd), 2) AS avg_ransom_paid,
    ROUND(AVG(disclosure_date - incident_date), 0) AS avg_disclusor_delay

FROM financial_impact fi

JOIN market_reaction mr
ON fi.incident_id = mr.incident_id
JOIN incident_metadata im
ON fi.incident_id = im.incident_id;


SELECT
    sector_index,
    COUNT(*) AS indicents_amount,
    SUM(total_loss_usd) AS total_loss,
    ROUND(AVG(total_loss_usd), 2) AS avg_loss

FROM market_reaction mr

JOIN financial_impact fi 
ON mr.incident_id = fi.incident_id

GROUP BY sector_index
