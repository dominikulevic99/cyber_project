/*
 ====================================================
 Section 3 - Rasnom Analysis
 ====================================================
 
 Objective:
 Evaluate whether ransom payments influence financial outcomes and determine which industries are most affected by ransomware attacks.
 
 Business Questions:
 1. How often do companies pay the ransom?
 2. Does paying ransom reduce total financial losses?
 3. Does paid ransom has effect on total loss in sectors?
 4. Which industries pay the largest ransoms?
 5. Which sectors have above-average ransom payments?
 
 */
-- 1,2 
WITH status_counts AS (
    SELECT CASE
            WHEN ransom_paid_usd IS NOT NULL THEN 'Paid'
            ELSE 'Not Paid'
        END AS ransom_status,
        COUNT(*) AS incidents,
        ROUND(AVG(total_loss_usd), 2) AS avg_total_loss
    FROM financial_impact
    WHERE total_loss_usd IS NOT NULL
    GROUP BY CASE
            WHEN ransom_paid_usd IS NOT NULL THEN 'Paid'
            ELSE 'Not Paid'
        END
)
SELECT ransom_status,
    incidents,
    -- Divides this category's incidents by the total sum of the subquery
    ROUND(
        incidents * 100.0 / (
            SELECT SUM(incidents)
            FROM status_counts
        ),
        2
    ) AS incident_percentage,
    avg_total_loss
FROM status_counts;
-- 3
SELECT mr.sector_index,
    CASE
        WHEN fi.ransom_paid_usd IS NOT NULL THEN 'Paid'
        ELSE 'Not Paid'
    END AS ransom_status,
    COUNT(*) AS incidents,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_total_loss
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
GROUP BY mr.sector_index,
    ransom_status
ORDER BY mr.sector_index;
-- 4
SELECT mr.sector_index,
    ROUND(AVG(fi.ransom_paid_usd), 2) AS avg_ransom_paid,
    ROUND(SUM(fi.ransom_paid_usd), 2) AS total_ransom_paid,
    COUNT(*) AS ramson_count
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
WHERE ransom_paid_usd IS NOT NULL
GROUP BY mr.sector_index
ORDER BY total_ransom_paid DESC;
-- 5 with Subquery and ETS methods
SELECT sector_index,
    ROUND(AVG(ransom_paid_usd), 2) AS avg_sector_ransom,
    COUNT(*) AS incidents_amount
FROM financial_impact fi
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
WHERE ransom_paid_usd IS NOT NULL
GROUP BY sector_index
HAVING AVG(fi.ransom_paid_usd) > (
        SELECT AVG(ransom_paid_usd)
        FROM financial_impact
        WHERE ransom_paid_usd IS NOT NULL
    )
ORDER BY avg_sector_ransom DESC;
WITH sector_ransom AS (
    SELECT sector_index,
        ROUND(AVG(ransom_paid_usd), 2) AS avg_sector_ransom,
        COUNT(*) AS incidents_amount
    FROM financial_impact fi
        JOIN market_reaction mr ON fi.incident_id = mr.incident_id
    WHERE ransom_paid_usd IS NOT NULL
    GROUP BY sector_index
),
overall_ransom AS (
    SELECT ROUND(AVG(ransom_paid_usd), 2) AS overall_ransom_paid
    FROM financial_impact
    WHERE ransom_paid_usd IS NOT NULL
)
SELECT sector_ransom.sector_index,
    sector_ransom.avg_sector_ransom,
    overall_ransom.overall_ransom_paid,
    sector_ransom.incidents_amount
FROM sector_ransom,
    overall_ransom
WHERE sector_ransom.avg_sector_ransom > overall_ransom.overall_ransom_paid
ORDER BY sector_ransom.avg_sector_ransom DESC;