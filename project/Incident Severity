/*
 ====================================================
 Section Section 5 — Incident Sevirity
 ====================================================
 
 Objective
 Identify characteristics of the most damaging cyber incidents and look on loss map.
 
 1. Find incidents whose total losses exceed the average loss of all incidents.
 2. Find the Top 10 most financially damaging incidents.
 3. Categorise incidents by severity:
 Critical (>100M)
 High (20M–100M)
 Medium (5M–20M)
 Low (<5M)
 
 */
-- 1
SELECT company_name,
    total_loss_usd
FROM financial_impact fi
    JOIN incident_metadata im ON fi.incident_id = im.incident_id
WHERE total_loss_usd IS NOT NULL
    AND total_loss_usd > (
        SELECT ROUND(AVG(total_loss_usd), 2)
        FROM financial_impact
        WHERE total_loss_usd IS NOT NULL
    )
ORDER BY total_loss_usd DESC;
-- 2
SELECT im.company_name,
    mr.sector_index,
    fi.total_loss_usd
FROM financial_impact fi
    JOIN incident_metadata im ON fi.incident_id = im.incident_id
    JOIN market_reaction mr ON fi.incident_id = mr.incident_id
ORDER BY fi.total_loss_usd DESC
LIMIT 10;
WITH incident_data AS (
    SELECT fi.incident_id,
        im.company_name,
        mr.sector_index,
        fi.total_loss_usd
    FROM financial_impact fi
        JOIN incident_metadata im ON fi.incident_id = im.incident_id
        JOIN market_reaction mr ON fi.incident_id = mr.incident_id
)
SELECT *
FROM incident_data
ORDER BY total_loss_usd DESC
LIMIT 10;
-- 3
WITH categorized_incidents AS (
    SELECT fi.incident_id,
        CASE
            WHEN fi.total_loss_usd < 5000000 THEN 'Low'
            WHEN fi.total_loss_usd > 100000000 THEN 'Critical'
            WHEN fi.total_loss_usd BETWEEN 20000000 AND 100000000 THEN 'High'
            ELSE 'Medium'
        END AS loss_status
    FROM financial_impact fi
    WHERE fi.total_loss_usd IS NOT NULL
)
SELECT loss_status,
    COUNT(*) AS incidents_amount
FROM categorized_incidents
GROUP BY loss_status
ORDER BY incidents_amount DESC;