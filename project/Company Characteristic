/*
 ====================================================
 Section Section 2 — Company Characteristics
 ====================================================
 
 Objective:
 Understand whether organisational characteristics influence the financial consequences of cyberattacks.
 
 Business Questions:
 1. Do larger companies lose more money?
 2. Do public companies suffer more severe cyberattacks than private companies?
 
 
 */
-- 1
SELECT CASE
        WHEN md.employee_count < 100 THEN 'Small company'
        WHEN md.employee_count BETWEEN 100 AND 999 THEN 'Medium company'
        WHEN md.employee_count >= 1000 THEN 'Large company'
        ELSE 'Unknown'
    END AS company_size,
    COUNT(*) AS number_of_incidents,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_total_loss_usd,
    ROUND(SUM(fi.total_loss_usd), 2) AS total_loss_usd
FROM incident_metadata AS md
    INNER JOIN financial_impact AS fi ON md.incident_id = fi.incident_id
WHERE fi.total_loss_usd IS NOT NULL
GROUP BY company_size
ORDER BY avg_total_loss_usd DESC;
-- 2
SELECT CASE
        WHEN md.is_public_company = TRUE THEN 'Public company'
        ELSE 'Private company'
    END AS company_style,
    COUNT(*) AS number_of_incidents,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_total_loss_usd,
    ROUND(SUM(fi.total_loss_usd), 2) AS total_loss_usd
FROM incident_metadata AS md
    INNER JOIN financial_impact AS fi ON md.incident_id = fi.incident_id
WHERE fi.total_loss_usd IS NOT NULL
GROUP BY company_style
ORDER BY avg_total_loss_usd DESC;