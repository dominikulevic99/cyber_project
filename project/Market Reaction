-- Market reaction
-- 1. How much does the stock price fall after disclosure?
-- 2. Recovery percentage 30 days after attack 
-- 3. How many days takes for full recovery in among sectors
/*
 ====================================================
 Section Section 4 — Market Reaction
 ====================================================
 
 Objective
 
 Measure investor reaction following cyberattack disclosure and evaluate market recovery across industries.
 
 Business Questions
 
 1. How much does the stock price fall after disclosure?
 2. What percentage of the stock price recovers within 30 days?
 3. How many days does full recovery take across industries?
 4. Do companies that disclose attacks faster experience lower losses?
 5. Which sectors recover slower than the overall average?
 
 */
-- 1, 2, 3
SELECT mr.sector_index,
    COUNT(*) AS incidents,
    ROUND(
        AVG(
            (
                (price_disclosure_day - price_7d_before) / price_7d_before
            ) * 100
        ),
        2
    ) AS avg_disclosure_change_pct,
    ROUND(
        AVG(
            (
                (price_30d_after - price_disclosure_day) / price_disclosure_day
            ) * 100
        ),
        2
    ) AS avg_recovery_pct_in_30_days,
    ROUND(AVG(days_to_price_recovery), 2) AS avg_days_to_recovery
FROM market_reaction mr
GROUP BY mr.sector_index
ORDER BY avg_disclosure_change_pct;
-- 4 In this case we assuming 'Fast' as above average recovery
WITH days_to_disclosure AS (
    SELECT incident_id,
        (disclosure_date - incident_date) AS days_to_disclosure
    FROM incident_metadata
    WHERE disclosure_date IS NOT NULL
        AND incident_date IS NOT NULL
),
avg_indicator AS (
    SELECT AVG(days_to_disclosure) AS avg_days
    FROM days_to_disclosure
)
SELECT CASE
        WHEN dtd.days_to_disclosure > ai.avg_days THEN 'Slow'
        ELSE 'Fast'
    END AS disclosure_status,
    COUNT(*) AS incidents,
    ROUND(AVG(fi.total_loss_usd), 2) AS avg_loss,
    ROUND(AVG(dtd.days_to_disclosure), 2) AS avg_days_to_disclosure
FROM financial_impact fi
    JOIN days_to_disclosure dtd ON fi.incident_id = dtd.incident_id
    CROSS JOIN avg_indicator ai
GROUP BY disclosure_status;
-- 5
SELECT sector_index,
    COUNT(*) AS incidents,
    ROUND(AVG(days_to_price_recovery), 2) AS avg_days_to_recovery
FROM market_reaction
WHERE days_to_price_recovery IS NOT NULL
GROUP BY sector_index
HAVING AVG(days_to_price_recovery) > (
        SELECT AVG(days_to_price_recovery)
        FROM market_reaction
        WHERE days_to_price_recovery IS NOT NULL
    )
ORDER BY avg_days_to_recovery DESC;